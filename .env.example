# Copie ce fichier en ".env" et remplis de vraies valeurs avant de lancer docker compose.

POSTGRES_USER=nombremystere
POSTGRES_PASSWORD=change_moi_en_un_mot_de_passe_fort
POSTGRES_DB=nombremystere

# Génère une valeur aléatoire, par exemple : openssl rand -hex 32
JWT_SECRET=change_moi_en_une_longue_chaine_aleatoire

# Port exposé sur la machine hôte
APP_PORT=3000

# Passe à "true" seulement si le site est servi en HTTPS (via un reverse proxy
# type Caddy/Nginx avec certificat). En HTTP simple, laisse "false" sinon les
# navigateurs refusent le cookie de session.
COOKIE_SECURE=false
